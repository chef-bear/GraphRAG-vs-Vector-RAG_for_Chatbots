# Copy to .env and change the passwords.

# --- PostgreSQL (docker compose; host port 5433 to avoid a native PG on 5432)
PG_HOST=localhost
PG_PORT=5433
PG_ADMIN_USER=fraud_admin
PG_ADMIN_PASSWORD=change-me-admin
# read-only role the agent connects as (created by the loader)
PG_AGENT_USER=fraud_agent
PG_AGENT_PASSWORD=change-me-agent

# --- Neo4j (docker compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_HEAP=1500m
NEO4J_PAGECACHE=1g

# --- Shared
# per-query timeout for agent queries, both DBs (seconds)
QUERY_TIMEOUT_S=30
DATA_DIR=data

# --- Ollama (runs natively on Windows; reachable via WSL mirrored networking)
OLLAMA_HOST=http://localhost:11434
NUM_CTX=16384
